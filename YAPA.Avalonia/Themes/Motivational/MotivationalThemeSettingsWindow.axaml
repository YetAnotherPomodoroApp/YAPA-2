<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YAPA.Avalonia.Themes.Motivational.MotivationalThemeSettingsWindow">
    <!-- YAPA.WPF.MotivationalTheme/MotivationalThemeSettingsWindow.xaml -->
    <Grid ColumnDefinitions="130,*">
        <CheckBox IsChecked="{Binding UseWhiteText, Mode=TwoWay}" Grid.Column="1" Content="Use white text" />
    </Grid>
</UserControl>
