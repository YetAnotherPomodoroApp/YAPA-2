<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YAPA.Avalonia.Plugins.PomodoroEngine"
             x:Class="YAPA.Avalonia.Plugins.PomodoroEngine.PomodoroEngineSettingWindow">
    <!-- YAPA/Plugins/PomodoroEngine/PomodoroEngineSettingWindow.xaml -->
    <UserControl.Resources>
        <local:StringToFontFamily x:Key="StringToFontFamily" />
    </UserControl.Resources>
    <Grid>
        <Grid ColumnDefinitions="*,2*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Name="ProfileSetting" />

            <Separator Margin="0,10,0,10" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="5" />

            <CheckBox IsChecked="{Binding Settings.CountBackwards, Mode=TwoWay}" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="6" Content="Count backwards" />

            <TextBlock Text="Display count of" Grid.Column="0" Grid.Row="7" />
            <ComboBox Name="CounterList" Grid.Column="1" Grid.Row="7" MinWidth="72" Margin="16,0,0,0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                      DisplayMemberBinding="{Binding Title}"
                      SelectedValueBinding="{Binding Item}"
                      SelectedValue="{Binding Settings.Counter, Mode=TwoWay}" />

            <Separator Margin="0,10,0,10" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="8" />

            <TextBlock Text="Font" Grid.Column="0" Grid.Row="9" />
            <ComboBox Name="FontSelector" Classes="tall" Grid.Column="1" Grid.Row="9" MinWidth="72" Margin="16,0,0,0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                      SelectedValueBinding="{Binding Key}"
                      SelectedValue="{Binding Settings.FontFamily, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Text="{Binding Key}" />
                            <TextBlock Grid.Row="1" Text="1234567890" FontSize="24"
                                       FontFamily="{Binding Value, Converter={StaticResource StringToFontFamily}}" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
    </Grid>
</UserControl>
