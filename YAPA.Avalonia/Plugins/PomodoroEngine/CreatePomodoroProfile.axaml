<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:YAPA.Avalonia.Infrastructure"
        x:Class="YAPA.Avalonia.Plugins.PomodoroEngine.CreatePomodoroProfile"
        Title="Pomodoro profile name" Height="100" Width="250"
        CanResize="False" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource MaterialPaperBrush}"
        FontFamily="{x:Static infra:Fonts.Roboto}">
    <!-- YAPA/Plugins/PomodoroEngine/CreatePomodoroProfile.xaml (a WPF tool window) -->
    <Grid RowDefinitions="*,Auto" ColumnDefinitions="Auto,*">
        <TextBlock Text="Profile name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Name="ProfileName" VerticalAlignment="Center" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="Save" Content="Save" Click="Save_Click" Margin="2" Classes="Flat" IsDefault="True" />
            <Button Name="Cancel" Content="Cancel" Click="Cancel_Click" Margin="2" Classes="Flat" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
