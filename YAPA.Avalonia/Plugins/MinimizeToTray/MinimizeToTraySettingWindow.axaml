<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:YAPA.Avalonia.Infrastructure"
             x:Class="YAPA.Avalonia.Plugins.MinimizeToTray.MinimizeToTraySettingWindow">
    <!-- YAPA/Plugins/MinimizeToTray/MinimizeToTraySettingWindow.xaml -->
    <!-- Same columns as the other pages; gaps instead of lines; the two icon colours on one row -->
    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,34,40">
        <CheckBox IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Grid.Row="0" Grid.Column="1" Content="Minimize to tray" />
        <CheckBox IsChecked="{Binding ShowInTaskbar, Mode=TwoWay}" Grid.Row="1" Grid.Column="1" Content="Show in taskbar" />

        <CheckBox IsChecked="{Binding ShowBalloonTipWhenInSystemTray, Mode=TwoWay}" Grid.Row="2" Grid.Column="1" Margin="0,16,0,0" Content="Show balloon tip when in system tray" />
        <CheckBox IsChecked="{Binding ShowApplicationOnBalloonTipClick, Mode=TwoWay}" Grid.Row="3" Grid.Column="1" Content="Show application when clicked on balloon tip" />
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Balloon tip for (s)" VerticalAlignment="Center" TextWrapping="Wrap" />
        <infra:EditableComboBox Name="BalloonTipSelect" Grid.Row="4" Grid.Column="1" Width="120"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  IsEnabled="{Binding ShowBalloonTipWhenInSystemTray}"
                  Text="{Binding TimeToDisplayBalloontip, Mode=TwoWay}" />

        <TextBlock Text="Icon colors" Grid.Column="0" Grid.Row="5" VerticalAlignment="Center" Margin="0,12,0,0" />
        <StackPanel Grid.Column="1" Grid.Row="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,12,0,0">
            <infra:ColorPickerBox Name="WorkTrayColor" Width="44" Color="{Binding WorkTrayIconColor, Mode=TwoWay}" ToolTip.Tip="Work icon color" />
            <TextBlock Text="Work" VerticalAlignment="Center" Margin="0,0,16,0" />
            <infra:ColorPickerBox Name="BreakTrayColor" Width="44" Color="{Binding BreakTrayIconColor, Mode=TwoWay}" ToolTip.Tip="Break icon color" />
            <TextBlock Text="Break" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
