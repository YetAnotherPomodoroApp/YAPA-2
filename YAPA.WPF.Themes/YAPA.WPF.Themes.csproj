<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>YAPA.WPF.Themes</RootNamespace>
    <AssemblyName>YAPA.WPF.Themes</AssemblyName>
    <!-- Assembly attributes come from the shared CommonAssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Themes are loaded at runtime from the Themes folder next to YAPA.exe -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\$(Configuration)\Themes\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\CommonAssemblyInfo.cs" Link="Properties\CommonAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="4.5.0" />
    <!-- These come in through YAPA.Shared; YAPA.exe ships them, so keep them out of the Themes folder -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="4.3.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Xceed.Wpf.Toolkit">
      <HintPath>..\Libraries\Xceed.Wpf.Toolkit.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yapa.Shared\YAPA.Shared.csproj" />
    <ProjectReference Include="..\YAPA.WPF.Shared\YAPA.WPF.Shared.csproj" />
  </ItemGroup>

</Project>
