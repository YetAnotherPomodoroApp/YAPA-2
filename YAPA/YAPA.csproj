<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>YAPA</RootNamespace>
    <AssemblyName>YAPA</AssemblyName>
    <ApplicationIcon>Resources\pomo.ico</ApplicationIcon>
    <!-- App.xaml.cs defines its own Main, so App.xaml is compiled as a plain page -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <!-- Assembly attributes come from CommonAssemblyInfo.cs; the version comes from GitVersion -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Same as the old project: AnyCPU that prefers 32-bit, so the x86 sqlite3.dll is the one used -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <!-- Release packaging (Build\YAPA2.nuspec) expects a flat ..\Release folder -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\$(Configuration)\</OutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <!-- Build\release-safety builds test versions with -p:ReleaseSafetyTest=true: only they honour
       YAPA_UPDATE_URL, YAPA_CRASH_DSN and /crashtest -->
  <PropertyGroup Condition="'$(ReleaseSafetyTest)' == 'true'">
    <DefineConstants>$(DefineConstants);RELEASE_SAFETY_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Autofac" Version="4.1.1" />
    <PackageReference Include="GitVersion.MsBuild" Version="5.8.1" PrivateAssets="all" />
    <PackageReference Include="LiveCharts.Wpf" Version="0.9.7" />
    <PackageReference Include="MaterialDesignThemes" Version="4.5.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="1.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational.Design" Version="1.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="1.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="1.1.0-preview4-final" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="4.7.15" />
    <PackageReference Include="Sentry" Version="7.0.1" />
    <PackageReference Include="SimpleFeedReader" Version="1.0.7" />
    <PackageReference Include="SQLite" Version="3.13.0" GeneratePathProperty="true" />
    <PackageReference Include="squirrel.windows" Version="1.5.28" />
    <PackageReference Include="WpfAnimatedGif" Version="1.4.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned above what the old EF Core 1.1 packages ask for, as packages.config did;
         Unsafe and Encodings.Web at what Sentry (crash reports) needs -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageReference Include="System.Text.Encodings.Web" Version="8.0.0" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Remoting" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="Xceed.Wpf.Toolkit">
      <HintPath>..\Libraries\Xceed.Wpf.Toolkit.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yapa.Shared\YAPA.Shared.csproj" />
    <ProjectReference Include="..\YAPA.WPF.Shared\YAPA.WPF.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CommonAssemblyInfo.cs" Link="Properties\CommonAssemblyInfo.cs" />
    <EmbeddedResource Update="Properties\Resources.resx" Generator="PublicResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" />
    <Compile Update="Properties\Resources.Designer.cs" AutoGen="True" DesignTime="True" DependentUpon="Resources.resx" />
    <None Update="Properties\Settings.settings" Generator="SettingsSingleFileGenerator" LastGenOutput="Settings.Designer.cs" />
    <Compile Update="Properties\Settings.Designer.cs" AutoGen="True" DesignTimeSharedInput="True" DependentUpon="Settings.settings" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled into YAPA.exe and used from XAML -->
    <Resource Include="Resources\backward.ico" />
    <Resource Include="Resources\loader.gif" />
    <Resource Include="Resources\pause.ico" />
    <Resource Include="Resources\pomo.ico" />
    <Resource Include="Resources\preferences.ico" />
    <Resource Include="Resources\stop.ico" />
    <EmbeddedResource Include="Resources\start.ico" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loose files the app reads from its install folder -->
    <Content Include="NLog.config" CopyToOutputDirectory="Always" />
    <Content Include="Resources\ding.wav" CopyToOutputDirectory="Always" />
    <Content Include="Resources\tick.wav" CopyToOutputDirectory="Always" />
    <Content Include="Resources\Pomodoro.png" CopyToOutputDirectory="Always" />
    <Content Include="Resources\pomoTray.ico" CopyToOutputDirectory="Always" />
    <None Update="Resources\Fonts\*.ttf" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native SQLite. The SQLite package only copies these for packages.config projects,
         so do it here: Microsoft.Data.Sqlite loads sqlite3.dll from the x86 or x64 subfolder. -->
    <Content Include="$(PkgSQLite)\runtimes\win7-x86\native\*" Link="x86\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="$(PkgSQLite)\runtimes\win7-x64\native\*" Link="x64\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
