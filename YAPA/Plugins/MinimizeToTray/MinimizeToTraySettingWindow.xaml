<UserControl x:Class="YAPA.Plugins.MinimizeToTray.MinimizeToTraySettingWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:YAPA.Shared;assembly=YAPA.WPF.Shared"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             >
    <!-- Check boxes under the settings column; the two icon colours share a row -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="38"></RowDefinition>
            <RowDefinition Height="42"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="1">
            <CheckBox Margin="0,3" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}">Minimize to tray</CheckBox>
            <CheckBox Margin="0,3" IsChecked="{Binding ShowInTaskbar, Mode=TwoWay}">Show in taskbar</CheckBox>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
            <CheckBox Margin="0,3" IsChecked="{Binding ShowBalloonTipWhenInSystemTray, Mode=TwoWay}">Show balloon tip when in system tray</CheckBox>
            <CheckBox Margin="0,3" IsChecked="{Binding ShowApplicationOnBalloonTipClick, Mode=TwoWay}">Show application when clicked on balloon tip</CheckBox>
        </StackPanel>
        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">Balloon tip for (s)</TextBlock>
            <ComboBox materialDesign:HintAssist.Hint="(editable)" x:Name="BalloonTipSelect" shared:Accessible.Label="Show balloon tip for, seconds"
                      Grid.Row="3" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                      IsEnabled="{Binding ShowBalloonTipWhenInSystemTray}"
                      VerticalAlignment="Center" 
                      IsEditable="True">
                <ComboBox.Text>
                    <Binding Path="TimeToDisplayBalloontip" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                    </Binding>
                </ComboBox.Text>
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
        <TextBlock Text="Icon colors" Grid.Column="0" Grid.Row="4" VerticalAlignment="Center"></TextBlock>
        <StackPanel Grid.Column="1" Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
            <xctk:ColorPicker x:Name="WorkTrayColor" shared:Accessible.Label="Work icon color" ToolTip="Work icon color"
                              Width="44" Height="24" ShowDropDownButton="False" SelectedColor="{Binding WorkTrayIconColor}" />
            <TextBlock Text="Work" VerticalAlignment="Center" Margin="8,0,20,0" />
            <xctk:ColorPicker x:Name="BreakTrayColor" shared:Accessible.Label="Break icon color" ToolTip="Break icon color"
                              Width="44" Height="24" ShowDropDownButton="False" SelectedColor="{Binding BreakTrayIconColor}" />
            <TextBlock Text="Break" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
